{
  "$comment": "CodeMeta's own crosswalk tables, one per mapping that has an upstream. They state which source field corresponds to which CodeMeta property; the comparison policy for each is decided in src/rs_metadata/mappings and is not upstream.",
  "crosswalks": {
    "cargo": {
      "source": "https://raw.githubusercontent.com/codemeta/codemeta/master/crosswalks/Cargo.csv",
      "format": "CodeMeta crosswalk: Cargo",
      "properties": {
        "codeRepository": [
          "package.repository"
        ],
        "softwareRequirements": [
          "dependencies, dev-dependencies, build-dependencies"
        ],
        "author": [
          "package.authors"
        ],
        "contributor": [
          "package.authors"
        ],
        "keywords": [
          "package.keyword"
        ],
        "license": [
          "package.license"
        ],
        "version": [
          "package.version"
        ],
        "name": [
          "package.authors"
        ],
        "url": [
          "package.homepage"
        ],
        "relatedLink": [
          "package.documentation"
        ],
        "email": [
          "package.authors"
        ],
        "maintainer": [
          "package.authors"
        ],
        "issueTracker": [
          "badges.is-it-maintained-open-issues"
        ],
        "readme": [
          "package.readme"
        ]
      }
    },
    "cff-1.2.0": {
      "source": "https://raw.githubusercontent.com/codemeta/codemeta/master/crosswalks/Citation%20File%20Format%201.2.0.csv",
      "format": "CodeMeta crosswalk: Citation File Format",
      "properties": {
        "codeRepository": [
          "repository-code"
        ],
        "downloadUrl": [
          "(repository-artifact) / (url) / (repository) / (identifiers[i].type==url)"
        ],
        "softwareRequirements": [
          "references"
        ],
        "softwareVersion": [
          "version"
        ],
        "author": [
          "authors"
        ],
        "citation": [
          "preferred-citation / references"
        ],
        "datePublished": [
          "date-released"
        ],
        "keywords": [
          "keywords"
        ],
        "license": [
          "license / license-url"
        ],
        "version": [
          "version"
        ],
        "isPartOf": [
          "(identifiers)"
        ],
        "hasPart": [
          "(identifiers)"
        ],
        "description": [
          "abstract"
        ],
        "identifier": [
          "identifiers / person.orcid / doi",
          "person.orcid / identifiers / doi"
        ],
        "name": [
          "title",
          "entity.name"
        ],
        "sameAs": [
          "identifiers.url"
        ],
        "url": [
          "url / (repository) / (repository-code) / (repository-artifact) / (identifiers[i].type==url)"
        ],
        "relatedLink": [
          "url / (repository) / (repository-code) / (repository-artifact) / (identifiers[i].type==url)"
        ],
        "givenName": [
          "person.given-names"
        ],
        "familyName": [
          "person.family-names"
        ],
        "email": [
          "person.email / entity.email"
        ],
        "affiliation": [
          "person.affiliation"
        ],
        "address": [
          "person.address / entity.address"
        ],
        "softwareSuggestions": [
          "(references)"
        ],
        "referencePublication": [
          "preferred-citation"
        ]
      }
    },
    "github": {
